{
  "name": "@gblin-protocol/agent-treasury",
  "version": "0.1.0",
  "description": "A treasury for AI agents on Base: operating cash in USDC, surplus parked in GBLIN, and USDC pulled back just in time when an x402 invoice arrives. Library and CLI.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "gblin-treasury": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test:fork": "tsx scripts/test-fork.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gblinproject/gblin-treasury-risk-regime.git",
    "directory": "packages/agent-treasury"
  },
  "homepage": "https://gblin.digital/agents",
  "keywords": [
    "x402",
    "base",
    "agent",
    "treasury",
    "usdc",
    "gblin",
    "agentkit",
    "mcp"
  ],
  "dependencies": {
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/fetch": "^2.27.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}

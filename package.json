  "mcpName": "io.github.gblinproject/gblin-treasury-risk-regime",
  "description": "Market risk regime (calm/elevated/crash) and treasury tools for AI agents on Base. Free risk-regime reads, signed EIP-712 risk attestations as portable proof-of-diligence, and JIT swaps to USDC for x402 invoices.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",

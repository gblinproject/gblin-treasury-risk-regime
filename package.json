    "dist",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "init": "tsx src/init.ts",
    "test": "tsx scripts/test.ts",
    "demo": "tsx examples/demo-agent.ts",
    "prepublishOnly": "npm run build",
    "test:payments": "tsx scripts/test-payments-fork.ts"
  },

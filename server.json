{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gblinproject/gblin-treasury-risk-regime",
  "description": "GBLIN on Base for AI agents: risk regime, treasury plan for idle USDC, mint and redeem at NAV. Free.",
  "repository": {
    "url": "https://github.com/gblinproject/gblin-treasury-risk-regime",
    "source": "github"
  },
  "websiteUrl": "https://gblin.digital/agents",
  "version": "0.6.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@gblin-protocol/mcp-server",
      "version": "0.6.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GBLIN_RPC_URL",
          "description": "RPC URL for Base mainnet. Falls back to public endpoint if not set.",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.gblin.digital/mcp"
    }
  ]
}
